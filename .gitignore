/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.local
.env.prod
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# Archivos borrador / copias locales
*copy*
* copy*

# Estado del deploy FTP (generado por GitHub Actions en el servidor)
.ftp-state-*.json

# Cache Laravel (generado en servidor)
/bootstrap/cache/*.php

# Logs
/storage/logs/*.log
/errors.log
/php_errors.log

# Fitxers generats per Laravel Mix (no cal versionar)
/web/js/app.js
/web/css/app.css
/web/mix-manifest.json

# Fitxer intern del servidor FTP
/web/.ftpquota

# Fitxers de cdmon que es van colar al primer commit (baixat per FTP).
# Son del servidor: si el deploy els intenta pujar, cdmon respon 550.
/errors/
/logs/
/.ftpquota
